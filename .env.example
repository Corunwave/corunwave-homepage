# Supabase (server only — never prefix with NEXT_PUBLIC_)
SUPABASE_URL=https://<project-ref>.supabase.co
# Secret API key (sb_secret_...), Project Settings > API Keys. Not the legacy service_role JWT.
SUPABASE_SECRET_KEY=

# Resend
RESEND_API_KEY=
# Sender must belong to a domain verified in Resend (e.g. 코런웨이브 <noreply@your-domain>).
# Until a domain is verified, only onboarding@resend.dev works, and only to the Resend account email.
CONTACT_MAIL_FROM=
# Inbox that receives the inquiries (CEO address in production).
CONTACT_MAIL_TO=
