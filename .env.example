# Resend
RESEND_API_KEY=
# Sender must belong to a domain verified in Resend (e.g. 코런웨이브 <noreply@your-domain>).
# Until a domain is verified, only onboarding@resend.dev works, and only to the Resend account email.
CONTACT_MAIL_FROM=
# Inbox that receives the inquiries (CEO address in production).
CONTACT_MAIL_TO=

# Payload CMS (server only)
# Random string for signing sessions/tokens. Generate: openssl rand -base64 32
PAYLOAD_SECRET=
# Supabase Postgres connection string (pooled), Project Settings > Database > Connection string.
# Payload creates its own tables in the "payload" schema; existing public tables are untouched.
DATABASE_URL=

# Payload media/document storage — Supabase Storage via S3 compatibility
# Project Settings > Storage > S3 Connection.
S3_ENDPOINT=https://<project-ref>.storage.supabase.co/storage/v1/s3
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional. Public base URL of the bucket; derived from S3_ENDPOINT + S3_BUCKET when empty.
S3_PUBLIC_BASE_URL=

# Seed script only: first CEO account (scripts/seed-payload.ts)
SEED_CEO_EMAIL=
SEED_CEO_PASSWORD=

# Google Analytics 4 measurement ID (public by design, e.g. G-XXXXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
